# Ukrainian translation of PathMaster.
#
# Two rules in this file are load-bearing, not style (ADR-0004, ADR-0012):
#
#   * A translation never carries a mnemonic. The "&" in a msgid is English's
#     alone. The parenthesised form this file once used — "Файл(&F)" — put the
#     letter into the label itself, where NVDA read it a second time:
#     "Файл(F) підменю Alt+ f". Ukrainian menus therefore have no Alt+letter
#     access at all, and a gate in `pathmaster-core/tests/catalogue.rs` fails
#     the build if a mnemonic comes back.
#   * A tab character never appears in a translation. Accelerators such as
#     Ctrl+Z are appended by the code; typing one here would delete the
#     shortcut rather than misread it.
#
# Named braces — {n}, {operation} — are placeholders and must survive
# translation exactly, name for name. Percent signs are data: %PATH% and
# %SystemRoot% are the values this application edits.
#
msgid ""
msgstr ""
"Project-Id-Version: PathMaster 0.1.0\n"
"PO-Revision-Date: 2026-08-20 12:00+0300\n"
"Language-Team: Ukrainian\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: uk\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

#. Scope tab label.
msgid "User PATH"
msgstr "PATH користувача"

#. Scope tab label.
msgid "System PATH"
msgstr "PATH системи"

#. Tab label: the list of saved Snapshots, not the act of taking one.
msgid "Backups"
msgstr "Резервні копії"

#. List column header, first column: the entry's 1-based position in the PATH.
#. A sign, not a word. The delta-spec (§2.1, §14) writes this header as "#" in
#. both languages and fixes no Ukrainian form, so it stands as the source does
#. — «№» is one catalogue edit away should that be revisited.
msgid "#"
msgstr "#"

#. List column header: one PATH entry, exactly as stored.
msgid "Path"
msgstr "Шлях"

#. List column header: the Issues found for that entry.
msgid "Status"
msgstr "Стан"

#. Fix Issues list column header: the issues found for that entry, joined in
#. the same words the main list's Status column uses. Singular, and a different
#. word from "Status": every row in this dialog has a finding.
msgid "Issue"
msgstr "Проблема"

#. Fix Issues list column header: what the checkbox beside it will do to that
#. entry — delete it, or remove its quotes.
msgid "Action"
msgstr "Дія"

#. Backups list column header: when this Snapshot was taken, local time.
msgid "Date and time"
msgstr "Дата й час"

#. Backups list column header: which Scope this Snapshot holds. Its values are
#. the two Scope tab labels above.
msgid "Scope"
msgstr "Область"

#. Backups list column header: how many entries restoring this Snapshot would
#. load into the working copy.
msgid "Entries"
msgstr "Записи"

#. Backups list text, in the Entries column, for a Snapshot file that failed
#. validation: it cannot be restored, and its Restore button is disabled. Never
#. spoken as an announcement — the row carries it. Keep the brackets.
msgid "[Corrupted]"
msgstr "[Пошкоджено]"

#. Announcement: spoken when the User tab is activated or refreshed.
msgid "User PATH: {n} entry"
msgid_plural "User PATH: {n} entries"
msgstr[0] "PATH користувача: {n} запис"
msgstr[1] "PATH користувача: {n} записи"
msgstr[2] "PATH користувача: {n} записів"

#. Announcement: the zero case has its own string, never "0 entries".
msgid "User PATH: no entries"
msgstr "PATH користувача: немає записів"

#. Announcement: spoken when the System tab is activated or refreshed.
msgid "System PATH: {n} entry"
msgid_plural "System PATH: {n} entries"
msgstr[0] "PATH системи: {n} запис"
msgstr[1] "PATH системи: {n} записи"
msgstr[2] "PATH системи: {n} записів"

#. Announcement: the zero case has its own string, never "0 entries".
msgid "System PATH: no entries"
msgstr "PATH системи: немає записів"

#. Search field label, above each Scope's list. Constant, no mnemonic, and it
#. never carries the count.
msgid "Search:"
msgstr "Пошук:"

#. Announcement: spoken when Expanded Values is toggled on — the lists now show
#. each entry with its %VAR% references resolved.
msgid "Showing expanded values"
msgstr "Показано розгорнуті значення"

#. Announcement: spoken when Expanded Values is toggled off — the lists show
#. each entry exactly as the registry stores it.
msgid "Showing raw values"
msgstr "Показано збережені значення"

#. Announcement: the filtered count after a typing pause — {n} entries shown
#. of the Scope's {m}. The plural form is selected by {m}, the total.
msgid "{n} of {m} entry"
msgid_plural "{n} of {m} entries"
msgstr[0] "{n} з {m} запису"
msgstr[1] "{n} з {m} записів"
msgstr[2] "{n} з {m} записів"

#. Announcement: the filtered count's zero case — worded, never a bare "0".
msgid "No matching entries"
msgstr "Немає збігів"

#. Announcement: the Scope-named filtered count, on tab activation and Refresh
#. while the User tab is narrowed; also its StatusBar fragment then. Plural
#. by {m}.
msgid "User PATH: {n} of {m} entry"
msgid_plural "User PATH: {n} of {m} entries"
msgstr[0] "PATH користувача: {n} з {m} запису"
msgstr[1] "PATH користувача: {n} з {m} записів"
msgstr[2] "PATH користувача: {n} з {m} записів"

#. Announcement: the User tab's filtered zero case.
msgid "User PATH: no matching entries"
msgstr "PATH користувача: немає збігів"

#. Announcement: the Scope-named filtered count for the System tab.
msgid "System PATH: {n} of {m} entry"
msgid_plural "System PATH: {n} of {m} entries"
msgstr[0] "PATH системи: {n} з {m} запису"
msgstr[1] "PATH системи: {n} з {m} записів"
msgstr[2] "PATH системи: {n} з {m} записів"

#. Announcement: the System tab's filtered zero case.
msgid "System PATH: no matching entries"
msgstr "PATH системи: немає збігів"

#. Filter state name, in the View submenu, in the filter announcement and in
#. StatusBar field 0. No mnemonic: two of those three surfaces would print it.
msgid "All"
msgstr "Усі"

#. Filter state name: every entry with a non-empty Status. The other five
#. states reuse the Status column's own words below.
msgid "With issues"
msgstr "З проблемами"

#. Announcement: spoken when the Filter is changed to a narrowing state — the
#. composed search-and-filter count, named by the state that produced it.
#. {filter} is one of the seven state names. Plural by {m}, the total.
msgid "{filter}: {n} of {m} entry"
msgid_plural "{filter}: {n} of {m} entries"
msgstr[0] "{filter}: {n} з {m} запису"
msgstr[1] "{filter}: {n} з {m} записів"
msgstr[2] "{filter}: {n} з {m} записів"

#. Announcement: the filter count's zero case, still naming the state.
msgid "{filter}: no matching entries"
msgstr "{filter}: збігів немає"

#. StatusBar fragment for the User tab while its Filter is not "All": the
#. state named between the scope and its count. Plural by {m}.
msgid "User PATH: {filter} — {n} of {m} entry"
msgid_plural "User PATH: {filter} — {n} of {m} entries"
msgstr[0] "PATH користувача: {filter} — {n} з {m} запису"
msgstr[1] "PATH користувача: {filter} — {n} з {m} записів"
msgstr[2] "PATH користувача: {filter} — {n} з {m} записів"

#. StatusBar fragment: the User tab's filtered zero case, still named.
msgid "User PATH: {filter} — no matching entries"
msgstr "PATH користувача: {filter} — немає збігів"

#. StatusBar fragment for the System tab while its Filter is not "All".
msgid "System PATH: {filter} — {n} of {m} entry"
msgid_plural "System PATH: {filter} — {n} of {m} entries"
msgstr[0] "PATH системи: {filter} — {n} з {m} запису"
msgstr[1] "PATH системи: {filter} — {n} з {m} записів"
msgstr[2] "PATH системи: {filter} — {n} з {m} записів"

#. StatusBar fragment: the System tab's filtered zero case, still named.
msgid "System PATH: {filter} — no matching entries"
msgstr "PATH системи: {filter} — немає збігів"

#. Announcement: spoken when Copy put the focused entry on the clipboard. Fixed
#. text — it never repeats what was copied, because focus has just read the row.
msgid "Copied to clipboard"
msgstr "Скопійовано до буфера обміну"

#. Announcement: spoken when the clipboard write failed. Spoken at once and not
#. retried — NVDA says nothing of its own for an application-side copy, so a
#. silent failure would be indistinguishable from a missed keystroke.
msgid "Could not copy to clipboard"
msgstr "Не вдалося скопіювати до буфера обміну"

#. Announcement: spoken after the Fix Issues dialog repaired the checked rows,
#. once focus has landed, so the summary is heard last. Plural by {n}. There is
#. no zero form: nothing checked closes the dialog silently.
msgid "Fixed {n} entry"
msgid_plural "Fixed {n} entries"
msgstr[0] "Виправлено {n} запис"
msgstr[1] "Виправлено {n} записи"
msgstr[2] "Виправлено {n} записів"

#. Announcement: spoken after this Scope's entries reached the registry. Two
#. strings rather than one with the Scope filled in — the sentence agrees with
#. its subject, and a name dropped into a shared frame would not.
msgid "User PATH applied"
msgstr "PATH користувача застосовано"

#. Announcement: spoken after this Scope's entries reached the registry.
msgid "System PATH applied"
msgstr "PATH системи застосовано"

#. Announcement: an Apply did not complete. {cause} is one of the three cause
#. phrases below, translated before it is filled in. The frame carries the
#. final stop, so a cause stays a phrase you may move within the sentence.
msgid "Apply failed — {cause}."
msgstr "Не вдалося застосувати — {cause}."

#. Apply failure cause: the backup could not be written, so nothing was
#. written at all — the registry was never touched.
msgid "could not write a backup, no changes were made"
msgstr "не вдалося створити резервну копію, зміни не внесено"

#. Apply failure cause: the registry refused the write (an unelevated System
#. scope, most often).
msgid "access denied"
msgstr "відмовлено в доступі"

#. Apply failure cause: every other way the registry can fail — a key that
#. will not open, a value locked by another process, a re-read that failed.
msgid "the registry could not be written"
msgstr "не вдалося записати до реєстру"

#. Announcement: a Read-only Data run names its reason once at startup, and
#. the same text stands in StatusBar field 0. {reason} is one of the three
#. reason strings below, translated before it is filled in.
msgid "Read-only: {reason}"
msgstr "Лише читання: {reason}"

#. Read-only reason: the executable's own location could not be determined.
msgid "the application's own location is unknown"
msgstr "власне розташування застосунку невідоме"

#. Read-only reason: `data\` beside the executable could not be created.
msgid "the data directory cannot be created"
msgstr "не вдалося створити папку даних"

#. Read-only reason: `data\` exists but the startup write probe failed.
msgid "the data directory is not writable"
msgstr "папка даних недоступна для запису"

#. Read-only reason: the location `--data-dir` pointed this run at could not
#. be created or written, or the switch carried nothing to resolve. Names the
#. switch, not the directory — that is what tells it from the reason above.
#. `--data-dir` is what the user types and is never translated.
msgid "the --data-dir location cannot be used"
msgstr "розташування, вказане в --data-dir, неможливо використати"

#. Dialog title: an argument this application does not recognise was passed on
#. the command line and skipped; the run started normally. {arg} is the
#. argument, verbatim.
msgid "Unknown argument {arg} was ignored"
msgstr "Невідомий аргумент {arg} проігноровано"

#. Dialog title: the answer to `--help` and `-?`, which show the usage line
#. and exit without starting the application.
msgid "PathMaster command line"
msgstr "Командний рядок PathMaster"

#. The usage line, shared by both command-line dialogs. Everything after
#. "Usage:" is what the user types — switch names, tab values and the brackets
#. that mark an argument optional — and none of it is translated. Only <path>
#. stands for something the user supplies, so only that word is Ukrainian.
msgid "Usage: PathMaster.exe [--tab user|system|backups] [--data-dir <path>] [--help]"
msgstr "Використання: PathMaster.exe [--tab user|system|backups] [--data-dir <шлях>] [--help]"

#. Startup dialog title: `settings.json` could not be parsed and has been
#. set aside. The whole message is the title — a dialog body is never spoken.
msgid "Settings could not be read — defaults are in use"
msgstr "Не вдалося прочитати налаштування — використовуються типові значення"

#. Dialog after OK in the Settings dialog: `settings.json` could not be
#. written, so nothing was recorded and the run is exactly as it was. The
#. mirror of the message above; the whole message is the title.
msgid "Settings could not be written — nothing was changed"
msgstr "Не вдалося записати налаштування — нічого не змінено"

#. Status column word: the entry's path does not name an existing directory.
#. One word, never a sentence — NVDA reads the column on every arrow key.
msgid "Missing"
msgstr "Відсутній"

#. Status column word: the entry is not fully qualified, so what it names
#. depends on the current directory.
msgid "Relative"
msgstr "Відносний"

#. Status column word: the entry contains a double quote.
msgid "Quoted"
msgstr "У лапках"

#. Status column word: an earlier entry, in this scope or in System, means the
#. same path.
msgid "Duplicate"
msgstr "Дублікат"

#. Status column word: the entry is zero-length or whitespace only.
msgid "Empty"
msgstr "Порожній"

#. Status bar, appended to each scope's entry count: how many issues the last
#. diagnostic pass found there. Keep the leading space and the parentheses.
msgid " ({m} issue)"
msgid_plural " ({m} issues)"
msgstr[0] " ({m} проблема)"
msgstr[1] " ({m} проблеми)"
msgstr[2] " ({m} проблем)"

#. Status bar, right field: the length of both scopes merged, as Windows will
#. materialise it. Shown always, never spoken as an announcement.
msgid "Merged PATH: {n} char"
msgid_plural "Merged PATH: {n} chars"
msgstr[0] "Об’єднаний PATH: {n} символ"
msgstr[1] "Об’єднаний PATH: {n} символи"
msgstr[2] "Об’єднаний PATH: {n} символів"

#. Status bar, appended to the length above once it passes 8,191. The number is
#. a measured Windows limit and must survive translation; localise its digit
#. grouping if your language groups differently.
msgid " — exceeds 8,191 (cmd.exe limit)"
msgstr " — перевищує 8 191 (ліміт cmd.exe)"

#. Menu bar title.
msgid "&Edit"
msgstr "Редагування"

#. Menu bar title.
msgid "&File"
msgstr "Файл"

#. Menu bar title.
msgid "&Help"
msgstr "Довідка"

#. Menu bar title.
msgid "&Tools"
msgstr "Інструменти"

#. Menu bar title: commands that change what the list shows, between Edit and
#. Tools.
msgid "&View"
msgstr "Вигляд"

#. View menu item: focuses the Search field and selects its contents (Ctrl+F).
#. The code appends its accelerator.
msgid "&Search"
msgstr "Пошук"

#. View menu item: a check item toggling between raw and expanded rendering
#. (Ctrl+E). The label never changes — the check mark is what says which way it
#. went. The code appends its accelerator.
msgid "&Expanded Values"
msgstr "Розгорнуті значення"

#. View menu item: the submenu holding the seven exclusive filter states. The
#. states themselves are the two names above and the five Status column words.
msgid "&Filter"
msgstr "Фільтр"

#. View menu item: the coarse filter toggle (Ctrl+I) — "All" becomes "With
#. issues", any narrowing state becomes "All". A plain item with a constant
#. label: the submenu's radio marks are the state, not this. The code appends
#. its accelerator.
msgid "Toggle &Issues Filter"
msgstr "Перемкнути фільтр проблем"

#. View menu item: opens the PATH Tree dialog over the active Scope (Ctrl+T).
#. The code appends its accelerator.
msgid "PATH &Tree…"
msgstr "Дерево PATH…"

#. File menu item: writes the active Scope's entries to the registry (Ctrl+S).
#. The code appends its accelerator.
msgid "&Apply"
msgstr "Застосувати"

#. File menu item: closes the application, raising the close-confirm dialog
#. first when a scope has unsaved changes. The code appends its accelerator.
msgid "E&xit"
msgstr "Вихід"

#. Edit menu item: opens the Add dialog. The code appends its accelerator.
msgid "&Add Entry…"
msgstr "Додати запис…"

#. Edit menu item: opens the Edit dialog on the focused row (F2).
msgid "&Edit Entry…"
msgstr "Змінити запис…"

#. Edit menu item: deletes the focused entry, with no confirmation (Del).
msgid "&Delete Entry"
msgstr "Видалити запис"

#. Edit menu item: puts the focused entry, as the list is showing it, on the
#. clipboard (Ctrl+C).
msgid "Co&py"
msgstr "Копіювати"

#. Edit menu item: moves the focused entry one place earlier (Alt+Up).
msgid "&Move Up"
msgstr "Перемістити вгору"

#. Edit menu item: moves the focused entry one place later (Alt+Down).
msgid "Mo&ve Down"
msgstr "Перемістити вниз"

#. Edit menu item: opens the Fix Issues dialog over the active scope. No
#. accelerator — an occasional bulk-review dialog, like Settings.
msgid "Fix &Issues…"
msgstr "Виправити проблеми…"

#. Edit menu item: undoes the last operation (Ctrl+Z). "Скасувати дію" rather
#. than a bare "Скасувати", which is the Cancel button below.
msgid "&Undo"
msgstr "Скасувати дію"

#. Edit menu item: redoes the operation last undone (Ctrl+Y).
msgid "&Redo"
msgstr "Повторити дію"

#. Edit menu item: the Cancel command — discards this Scope's unsaved changes
#. back to the value last read. Not the Cancel *button* of a dialog, which is
#. "Cancel" below and means "do not commit" (ADR-0004).
msgid "&Cancel Changes"
msgstr "Відхилити зміни"

#. Edit menu item: re-reads the active Scope from the registry (F5).
msgid "Re&fresh"
msgstr "Оновити"

#. Tools menu item: opens the Settings dialog. The "…" marks a menu item
#. that opens a dialog.
msgid "&Settings…"
msgstr "Налаштування…"

#. Tools menu item: hands the folder the Snapshot files live in to the shell.
#. "Backups" here is the directory, as in the tab label above.
msgid "&Open Backups Folder"
msgstr "Відкрити теку резервних копій"

#. Tools menu item: the one entry point into elevation — relaunches the whole
#. application via the UAC prompt. Disabled when already elevated. No "…":
#. what follows is the UAC prompt and a relaunch, not a dialog of ours.
msgid "&Restart as Administrator"
msgstr "Перезапустити від імені адміністратора"

#. Help menu item, first in the menu: opens the User Guide in the browser, and
#. carries F1. No "…" — what follows is a browser window, not a dialog of ours.
msgid "&User Guide"
msgstr "Посібник користувача"

#. Help menu item: opens the About dialog. No "…" — it states rather than
#. asks.
msgid "&About"
msgstr "Про програму"

#. The About dialog, which is entirely its title. "PathMaster" is the product
#. name and "MIT" the licence identifier: both are proper nouns and stay as
#. they are. {version} is the build's version number.
msgid "PathMaster {version} — MIT License"
msgstr "PathMaster {version} — ліцензія MIT"

#. Button under a Scope's list: opens the Add dialog. Buttons carry no
#. mnemonic — the Tab order is the map, and an "&" would race the menu bar.
msgid "Add…"
msgstr "Додати…"

#. Button under a Scope's list: opens the Edit dialog on the focused row.
msgid "Edit…"
msgstr "Змінити…"

#. Button under a Scope's list: deletes the focused entry.
msgid "Delete"
msgstr "Видалити"

#. Button under a Scope's list: moves the focused entry one place earlier.
msgid "Move Up"
msgstr "Перемістити вгору"

#. Button under a Scope's list: moves the focused entry one place later.
msgid "Move Down"
msgstr "Перемістити вниз"

#. Button under a Scope's list: writes this Scope's entries to the registry.
#. Disabled while there is nothing unsaved.
msgid "Apply"
msgstr "Застосувати"

#. Button under a Scope's list: the Cancel command — discards this Scope's
#. unsaved changes. Disabled while there are none.
msgid "Cancel Changes"
msgstr "Відхилити зміни"

#. Button on the Backups tab: loads the chosen Snapshot into its Scope's
#. working copy as one undoable step. Nothing is written until that Scope is
#. applied, which is why the label promises no more than it does.
msgid "Restore"
msgstr "Відновити"

#. Title of the PATH Tree dialog over the User PATH. It is the whole of what a
#. screen reader speaks when the modal opens, so it names the scope — nothing
#. else inside the dialog says which PATH is being looked at.
msgid "PATH Tree — User PATH"
msgstr "Дерево PATH — PATH користувача"

#. Title of the PATH Tree dialog over the System PATH, as above.
msgid "PATH Tree — System PATH"
msgstr "Дерево PATH — PATH системи"

#. Default button of the PATH Tree dialog: selects the chosen entry's row in
#. the main list and closes. Disabled while the selection is a folder node or a
#. group. No mnemonic, like every other button here.
msgid "Go to entry"
msgstr "Перейти до запису"

#. PATH Tree group node: gathers the entries that begin with a %VAR% this run
#. does not define, which have no place under any drive. Plural, and named for
#. the entries rather than for the fault.
msgid "Unresolved variables"
msgstr "Нерозв'язані змінні"

#. PATH Tree group node: gathers the entries that are not fully qualified, as
#. above.
msgid "Relative entries"
msgstr "Відносні записи"

#. Title of the Fix Issues dialog over the User PATH. Like the PATH Tree titles
#. it names the scope, because the title is all a screen reader speaks when the
#. modal opens.
msgid "Fix issues — User PATH"
msgstr "Виправлення проблем — PATH користувача"

#. Title of the Fix Issues dialog over the System PATH, as above.
msgid "Fix issues — System PATH"
msgstr "Виправлення проблем — PATH системи"

#. Default button of the Fix Issues dialog: applies the checked rows to the
#. working copy. Never "Apply" — that word is reserved for the registry write.
msgid "Fix selected"
msgstr "Виправити позначені"

#. Fix Issues Action cell: this entry keeps its place and loses every quote
#. character in its text. Its sibling action reuses "Delete entry" below.
msgid "Remove quotes"
msgstr "Прибрати лапки"

#. Dialog title when an existing entry is edited, and the operation name in
#. "Undone: {operation}" — hence a verbal noun. It keeps its capital because
#. it is also a title; a screen reader does not speak capitalisation.
msgid "Edit entry"
msgstr "Редагування запису"

#. Dialog title when a new entry is added, and the operation name in
#. "Undone: {operation}" — a verbal noun, as above.
msgid "Add entry"
msgstr "Додавання запису"

#. Button in the Add/Edit dialog: opens the Windows folder picker.
msgid "Browse…"
msgstr "Огляд…"

#. Title of the Windows folder picker Browse opens.
msgid "Choose a folder"
msgstr "Виберіть папку"

#. Affirmative button of our own dialogs. Kept as "OK" in every language so it
#. matches the one stock button left in the application.
msgid "OK"
msgstr "OK"

#. Negative button of our own dialogs: "do not commit", "close this dialog".
#. Not the Cancel command, which is "Cancel Changes" above (ADR-0004).
msgid "Cancel"
msgstr "Скасувати"

#. Affirmative button of a confirmation.
msgid "Yes"
msgstr "Так"

#. Negative button of a confirmation.
msgid "No"
msgstr "Ні"

#. Validation error: the whole message is the dialog's title. {character} is
#. the rejected character itself — one of < > | " or the ; separator.
msgid "The entry contains a forbidden character: {character}"
msgstr "Запис містить заборонений символ: {character}"

#. Validation error: the path field was left empty. Whitespace is not empty.
msgid "The entry cannot be empty"
msgstr "Запис не може бути порожнім"

#. Validation error in the Settings dialog: the "Snapshots to keep" field held
#. something that is not a whole number of at least 1. Zero is outlawed —
#. rotation at zero would delete the pre-Apply safety net.
msgid "Snapshots to keep must be a whole number, 1 or more"
msgstr "Кількість знімків має бути цілим числом, не меншим за 1"

#. Validation error in the Settings dialog: the "Delay before speaking the
#. count" field held something that is not a whole number of 0 to 5000. Zero is
#. legal — speak on the next tick; the ceiling keeps a typo from silently
#. muting a feature the user believes is on.
msgid "Delay before speaking the count must be a whole number, 0 to 5000"
msgstr "Затримка перед озвученням кількості має бути цілим числом від 0 до 5000"

#. Settings dialog title (Tools -> Settings…).
msgid "Settings"
msgstr "Налаштування"

#. Label of the Settings dialog's language selector. The parenthesis is the
#. whole notice that the language applies only after a restart — there is no
#. announcement for it, so this label must carry it.
msgid "Language (takes effect after restart)"
msgstr "Мова (набуде чинності після перезапуску)"

#. First item of that selector: follow the language Windows itself is showing.
#. The other items are the languages' own endonyms and are never translated.
msgid "Follow the system language"
msgstr "Використовувати мову системи"

#. Label of the Settings dialog's backup-budget field: how many Snapshot files
#. are kept for each of the two PATH scopes before the oldest is deleted.
#. "Snapshot" (знімок), not "backup" — the latter names the directory.
msgid "Snapshots to keep per PATH"
msgstr "Скільки знімків зберігати для кожного PATH"

#. Label of a Settings dialog checkbox: whether the spoken counts of a narrowed
#. list are made at all. The label is the checkbox's own — a checkbox carries
#. its accessible name, so there is no separate caption to keep in step.
msgid "Speak filtered entry counts"
msgstr "Озвучувати кількість відфільтрованих записів"

#. Label of the Settings dialog's count-delay field: how long typing must pause
#. before the count of matching entries is spoken. "(ms)" is milliseconds, kept
#. short so the label stays the width of a label.
msgid "Delay before speaking the count (ms)"
msgstr "Затримка перед озвученням кількості (мс)"

#. Label of a Settings dialog checkbox: whether the Escape key in the search
#. field moves focus back to the entry list. Escape clears the field either
#. way. "Escape" is the key's name as Windows and NVDA speak it.
msgid "Escape returns focus to the list"
msgstr "Escape повертає фокус до списку"

#. Dialog title: an entry using %VAR% is being committed into a Scope stored
#. as REG_SZ, which does not expand it. %VAR% and REG_SZ are literal data.
msgid "This entry uses %VAR%, but the value type (REG_SZ) does not expand variables"
msgstr "Цей запис використовує %VAR%, але тип значення (REG_SZ) не розгортає змінні"

#. Button of that dialog: convert the Scope to REG_EXPAND_SZ. Literal data.
msgid "Change type to REG_EXPAND_SZ"
msgstr "Змінити тип на REG_EXPAND_SZ"

#. Button of that dialog: commit the entry, leaving the value type alone.
msgid "Keep as literal text"
msgstr "Залишити як звичайний текст"

#. Confirmation title for the Cancel command. Undoable, so it says no more.
msgid "Discard changes?"
msgstr "Відхилити зміни?"

#. Confirmation title for Refresh, which unlike Cancel cannot be undone.
msgid "Refresh discards your unsaved changes and the undo history — continue?"
msgstr "Оновлення відхилить незбережені зміни та історію скасувань — продовжити?"

#. Title of the one dialog raised when the application is closed with unsaved
#. changes. {scopes} is filled with the dirty scopes' own tab labels, joined
#. with a comma — use the same tab labels this file already translates.
msgid "Unsaved changes in: {scopes} — save before closing?"
msgstr "Незбережені зміни: {scopes} — зберегти перед закриттям?"

#. Button of that dialog: apply every dirty scope, then close. The domain word
#. for what it performs is "apply"; this button says "save" because that is
#. what a close-confirm is expected to say.
msgid "Save"
msgstr "Зберегти"

#. Button of that dialog: close without writing anything. Distinct from the
#. "Cancel Changes" command ("Відхилити зміни") and from the "Discard
#. changes" operation name ("Відхилення змін") — three meanings, three
#. strings.
msgid "Discard"
msgstr "Відхилити"

#. Dialog title: the registry value changed under us between the last read
#. and this Apply. The whole message is the title.
msgid "PATH was modified externally since last refresh"
msgstr "PATH було змінено ззовні після останнього оновлення"

#. Button of that dialog: write anyway, over the value just found.
msgid "Overwrite"
msgstr "Перезаписати"

#. Button of that dialog: adopt the value just found and write nothing, losing
#. the unsaved changes and the undo history with it.
msgid "Refresh and discard my changes"
msgstr "Оновити й відхилити мої зміни"

#. Dialog title at Apply: past this length cmd.exe ignores PATH entirely.
#. 8,191 is a measured Windows limit and must survive translation; localise its
#. digit grouping if your language groups differently. {n} is the length this
#. Apply would leave behind.
msgid "cmd.exe will ignore a PATH longer than 8,191 characters ({n} after this Apply)"
msgstr "cmd.exe ігноруватиме PATH, довший за 8 191 символ ({n} після цього застосування)"

#. Button of that dialog: proceed knowingly. Legal — the limit is cmd.exe's.
msgid "Apply Anyway"
msgstr "Усе одно застосувати"

#. Dialog title at Apply: the hard cap, which nothing can proceed past. Its
#. only button is "Cancel". 32,767 is a measured Windows limit.
msgid "PATH cannot exceed 32,767 characters ({n} after this Apply)"
msgstr "PATH не може перевищувати 32 767 символів ({n} після цього застосування)"

#. Dialog title: the restart command's own close-confirm, raised only when the
#. User Session is dirty — the relaunch destroys unsaved changes, and the
#. title names what is lost. "User" here is the User PATH Scope, named as the
#. tab is: "PATH користувача".
msgid "Discard unsaved User changes and restart as administrator?"
msgstr ""
"Відхилити незбережені зміни PATH користувача та перезапустити від імені "
"адміністратора?"

#. Button of that dialog: both halves of what pressing it does. Not the
#. Discard of the close-confirm — that one only closes.
msgid "Discard and Restart"
msgstr "Відхилити та перезапустити"

#. Dialog title after a declined UAC prompt, [OK] only: nothing changed, the
#. application keeps running unelevated. Never silent — silence after a
#. security prompt reads as a defect.
msgid "Elevation was cancelled — still running without administrator rights"
msgstr ""
"Підвищення прав скасовано — програма й далі працює без прав адміністратора"

#. The elevated instance's window title — the cmd.exe convention. Alt+Tab
#. speaks it first, which is how the user tells the two instances apart.
#. "PathMaster" is the product name and stays untranslated.
msgid "Administrator: PathMaster"
msgstr "Адміністратор: PathMaster"

#. Announcement: spoken after Ctrl+Z. {operation} is one of the operation
#. names in this file, translated as a verbal noun.
msgid "Undone: {operation}"
msgstr "Скасовано: {operation}"

#. Announcement: spoken after Ctrl+Y.
msgid "Redone: {operation}"
msgstr "Повторено: {operation}"

#. Announcement suffix, appended to the two above when the undo re-dirtied a
#. Scope that had just been applied. Keep the leading comma and space.
msgid ", unsaved changes"
msgstr ", незбережені зміни"

#. Announcement: spoken after the Cancel command discards the changes.
msgid "Changes discarded"
msgstr "Зміни відхилено"

#. Operation name in "Undone: {operation}" — a verbal noun, not the button.
msgid "Delete entry"
msgstr "Видалення запису"

#. Operation name: one Move Up or Move Down. The direction is not named — the
#. row NVDA reads afterwards says it.
msgid "Move entry"
msgstr "Переміщення запису"

#. Operation name: the Cancel command that discarded the changes. A verbal
#. noun, never the imperative on the button ("Відхилити зміни").
msgid "Discard changes"
msgstr "Відхилення змін"

#. Operation name: the Scope's value type was converted.
msgid "Change value type"
msgstr "Зміна типу значення"

#. Operation name: a saved Snapshot was loaded into the working copy. "Знімок",
#. not "резервна копія" — the glossary reserves the latter for the act of
#. taking one and for the directory they live in, never for the file.
msgid "Restore snapshot"
msgstr "Відновлення знімка"

#. Operation name: the Fix Issues dialog's whole apply, however many rows it
#. touched — a verbal noun, as above ("Скасовано: виправлення проблем").
msgid "Fixing issues"
msgstr "Виправлення проблем"
